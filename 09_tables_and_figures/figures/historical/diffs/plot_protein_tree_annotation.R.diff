+.release_usage <- "Usage: Rscript plot_protein_tree_annotation.R --input-dir=DIR [--outdir=DIR]\nDIR must contain P_*.treefile and Fig2_tip_data.tsv; optional Fig2_conflict_splits.tsv, Fig2_conflict_regions.tsv\nDefault output folder: DIR. Without --input-dir the script folder (RStudio) or a file chooser is used.\nOutputs: Fig2_protein_tree_annotation.pdf/.png, Fig2_protein_tree_annotation_a_tree.pdf, Fig2_protein_tree_annotation_b_violin.pdf"
+.release_args <- commandArgs(trailingOnly = TRUE)
+.release_opt <- function(name, default = NULL) {
+  key <- paste0("--", name, "=")
+  hit <- .release_args[startsWith(.release_args, key)]
+  if (length(hit)) return(path.expand(sub(key, "", hit[length(hit)], fixed = TRUE)))
+  default
+}
+if (any(.release_args %in% c("--help", "-h"))) {
+  cat(.release_usage, "\n", sep = "")
+  quit(save = "no", status = 0)
+}
+## ---- [end release adaptation] ---------------------------------------------------
 
