# Example paths for the non-BRAKER stages. Copy to paths.env (ignored by git), edit,
# then:  set -a; source config/paths.env; set +a
# Only the variables of the stage you run are needed. Python scripts take
# command-line options instead (see each stage README).

# 03_annotation_evidence (positional arguments are also accepted, see README)

# 06_quality_and_filtering
PROTEIN_DIR=/path/to/02_longest_isoform_proteins        # run_busco_213_longest_isoform.sh
PROJECT=/path/to/busco_project                          # run_busco_213_longest_isoform.sh
BUSCO_DOWNLOAD_DIR=/path/to/busco_downloads             # offline BUSCO lineages (fungi_odb12, mucoromycota_odb12)
PROT_DIR=/path/to/protein_faa                           # run_omark_212.sh
OMAMER_DB=/path/to/LUCA.h5                              # run_omark_212.sh (OMAmer database)
OUT_DIR=/path/to/omark_output                           # run_omark_212.sh
REF12_BASE=/path/to/12_faa_12_gff_technical_validation  # 12-genome public reference comparison
REF12_BUSCO_PROJECT=/path/to/ref12_busco_project

# 07_functional_annotation
W=/path/to/interproscan_eggnog_workdir                  # ips_fix_20261011 chain
IPS=/path/to/interproscan.sh                            # ips_fix_20261011 chain
FREEZE_ROOT=/path/to/func_freeze                        # freeze_emapper_results.sh / freeze_interproscan_results.sh
FUNC_ROOT=/path/to/interproscan_eggnog                  # assemble_functional_tables.sh / subset_filtered10_functional_tables.sh
FAADIR=/path/to/02_202_longest_isoform_proteins         # assemble_functional_tables.sh
FILTDIR=/path/to/10_omark_filtered_faa                  # subset_filtered10_functional_tables.sh

# 05 GTF -> GFF3 (reconstructed wrapper)
G2G=/path/to/Augustus/scripts/gtf2gff.pl
GTF_DIR=/path/to/01_202_longest_isoform_gtf
GFF3_DIR=/path/to/new_gff3_output

# 08_phylogenomics
IQ=/path/to/iqtree3
WORK=/path/to/dual_tree_workdir                         # holds supermatrix_{P,G}_<tag>.fasta

# 10_release_packaging
REP_ROOT=/path/to/Mucoromycota_BRAKER_longest_isoform   # 01_202_*, 02_202_*, 06_202_* folders
FUNC_RELEASE=/path/to/07_202_functional_annotation      # output folder of assemble_functional_tables.sh
OUT=/path/to/new_release_folder                         # make_release_202.sh output (must not exist)
RELEASE=$OUT                                            # pack_release_202.sh input
SUBPHYLUM_MAP=/path/to/00_subphylum_map.tsv             # from derive_subphylum_map.py
#STRICT=1
