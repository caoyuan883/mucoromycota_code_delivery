# Site configuration for 04_structural_annotation/braker2 and 04_structural_annotation/braker3.
# Copy to braker_site.env (ignored by git), edit, then:
#   export BRAKER_SITE_ENV=$PWD/config/braker_site.env
# config.sh sources this file and stops if a required variable is empty.

# Software environment root. The scripts expect the historical layout below it:
#   $ENV_ROOT/braker2_bundle_transfer/src/BRAKER_src/scripts/braker.pl
#   $ENV_ROOT/braker2_bundle_transfer/src/AUGUSTUS_src/scripts/{gtf2gff.pl,getAnnoFastaFromJoingenes.py}
#   $ENV_ROOT/braker2_bundle_transfer/src/TSEBRA/bin/{tsebra.py,best_by_compleasm.py}
#   $ENV_ROOT/braker2_bundle_transfer/aux/GeneMark/...
ENV_ROOT=/path/to/braker_env_root

# Annotation data root. Expected sub-folders (historical names):
#   03_softmasked_genomes_v3/   (BRAKER2)   03_softmasked_genomes/ (BRAKER3)
#   RNA_SEQ/05_merged_bam/      (BRAKER3)   Fungi.clean.fa (protein database)
#   species_mode_mapping.csv    (BRAKER3 species list, or set SPECIES_MODE_CSV)
DATA_ROOT=/path/to/annotation_data_root

# Local BUSCO/compleasm lineage folder used inside BRAKER (historical: mucoromycota_odb12)
BUSCO_LINEAGE_DIR=/path/to/mucoromycota_odb12

# Optional: working folder for best_by_compleasm (06b/06c); compleasm keeps ./mb_downloads here.
# Default: the braker2 script folder.
#BBC_CWD=/path/to/folder_with_mb_downloads

# Monitoring scripts monitor_addon_two.sh / monitor_addon_one.sh do not source config.sh:
#BATCH_ROOT=$DATA_ROOT/11_braker2_batch_v3_scidata

# Optional: concurrency (defaults in config.sh: 8 threads per job, up to 4 jobs in parallel).
# Use MAX_PARALLEL=1 when resources are limited or for single-genome restarts.
#THREADS_PER_JOB=8
#MAX_PARALLEL=4
